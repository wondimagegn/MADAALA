# EthioContextEval Pilot — environment template
# Copy to .env for local overrides. Never commit .env or real secrets.
#
# AWS credentials must NOT be stored in git.
# Prefer: AWS CLI (`aws configure`), shell environment variables,
# or an IAM role on AWS infrastructure.
#
# Optional runtime env (standard boto3 chain):
#   AWS_ACCESS_KEY_ID
#   AWS_SECRET_ACCESS_KEY
#   AWS_SESSION_TOKEN

AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

ETHIOEVAL_MAX_TOKENS=500
ETHIOEVAL_TEMPERATURE=0
ETHIOEVAL_RUNS=2

# ETHIOEVAL_CONFIG=config/models.json
# ETHIOEVAL_DATA=data/scenarios.jsonl
# ETHIOEVAL_RESULTS_DIR=results

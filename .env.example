# EthioContextEval Pilot — environment template
# Copy to .env for local overrides. Never commit .env or real secrets.

# Provider: mock | ollama | bedrock
ETHIOEVAL_PROVIDER=ollama

# Local Ollama (default)
OLLAMA_BASE_URL=http://localhost:11434

# Generation controls
ETHIOEVAL_MAX_TOKENS=500
ETHIOEVAL_TEMPERATURE=0
ETHIOEVAL_RUNS=2

# Paths (optional)
# ETHIOEVAL_CONFIG=config/models.local.json
# ETHIOEVAL_DATA=data/scenarios.jsonl
# ETHIOEVAL_RESULTS_DIR=results

# --- Optional future Bedrock / AWS (not required for local pilot) ---
# AWS_REGION=us-east-1
# AWS_DEFAULT_REGION=us-east-1
# Credentials via AWS CLI / IAM role / env — never commit secrets:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

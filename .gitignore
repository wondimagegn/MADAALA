*.orig

# Large / sensitive raw model outputs and PRIVATE blind maps
results/raw/*
!results/raw/.gitkeep
results/blinded/*
!results/blinded/.gitkeep
# Explicitly keep private mappings out of git even if path patterns change
**/blind_mapping_*.csv
results/ratings/*.parquet
results/ratings/*.pkl
results/analysis/*.parquet
results/analysis/*.pkl

# Local model config overrides (example stays tracked)
config/models.json
!config/models.example.json

